# ==========================================
# flux Configuration (.env)
# ==========================================

# --- Core LLM Configuration (Google Gemini) ---
# Set your Google Gemini API Key here:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# --- GitHub Integration ---
# Increases GitHub API rate limit from 60 to 5,000 requests/hr and enables forking/PR creation:
GITHUB_TOKEN=your_github_token_here
# Optional custom GitHub API URL (defaults to public GitHub):
# GITHUB_API_URL=https://api.github.com
# Git committer identity used when creating pull requests:
# GIT_COMMITTER_NAME=flux-bot
# GIT_COMMITTER_EMAIL=bot@flux.dev

# --- Server & Network ---
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=8000
# Comma-separated or JSON list of allowed origins:
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Workspace & Storage ---
# WORKSPACES_DIR=../workspaces
# DATABASE_PATH=../backend/flux.db

# --- Agent & Routing Limits ---
# MAX_DIFF_LINES_FOR_PR=150
# MAX_FILES_TOUCHED_FOR_PR=4
# OPENCODE_CLI_CMD=opencode
# OPENCODE_MODEL=
# OPENCODE_TIMEOUT=120
# DEMO_MODE=false

# --- Frontend Client ---
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
